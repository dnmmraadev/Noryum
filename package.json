{
  "name": "noryum",
  "version": "0.1.2",
  "private": true,
  "description": "Un espacio personal para ver patrones y dar forma a tu día.",
  "author": "Noryum",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build --configLoader native && node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/smoke.cjs",
    "package": "pnpm build && electron-builder --win portable nsis --x64",
    "package:folder": "pnpm build && node scripts/package-portable.mjs"
  },
  "build": {
    "appId": "app.noryum.desktop",
    "productName": "Noryum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Noryum-${version}-${arch}-${target}.${ext}"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "type": "module"
}
