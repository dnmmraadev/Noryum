{
  "name": "noryum-intelligent-business-engineering",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --configLoader native --pool threads",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "desktop": "electron .",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs",
    "package:installer": "npm run build && electron-builder --win portable --x64",
    "format": "prettier --write src electron scripts"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "44.4.2",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11",
    "resedit": "1.7.2",
    "pe-library": "0.4.1"
  },
  "build": {
    "appId": "com.noryum.desktop",
    "productName": "Noryum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico"
    }
  },
  "description": "Noryum - Intelligent Business Engineering. A local-first workspace for evidence-based career development.",
  "author": "Noryum",
  "productName": "Noryum",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnmmraadev/Noryum.git"
  },
  "bugs": {
    "url": "https://github.com/dnmmraadev/Noryum/issues"
  }
}
